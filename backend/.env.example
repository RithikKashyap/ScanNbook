# Server Configuration
PORT=3100
NODE_ENV=development

# Database Configuration
DATABASE_URL=mongodb://localhost:27017/qr-booking-system

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# UPI Configuration
UPI_ID=your-upi-id@bank
UPI_PAYEE_NAME=Jharkhand Chhatriya Sangh Bhawan

# QR Code Security
QR_CODE_SECRET=your_qr_code_security_secret_here

# Email Service (Optional)
EMAIL_SERVICE_API_KEY=your_email_service_api_key_here

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://127.0.0.1:3000,http://127.0.0.1:3100

# Admin Login UI Settings
ADMIN_LOGIN_ENABLED=true
ADMIN_LOGIN_MODULES=Complaint Management,Booking Details,Contact,Service,View Bhawan

# Booking Time Settings (24-hour HH:mm)
BOOKING_CHECKIN_TIME=07:30
BOOKING_CHECKOUT_TIME=06:30

# Permanent Banner Settings
PERMANENT_BANNER_ENABLED=true
PERMANENT_BANNER_BACKGROUND=Bhawan
